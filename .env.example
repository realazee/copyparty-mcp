# Copyparty MCP Server Configuration
# Copy this file to .env and fill in your values.

# Required: Base URL of your Copyparty server
COPYPARTY_BASE_URL=http://localhost:3923

# Optional: Password for authentication
COPYPARTY_PASSWORD=

# Optional: Comma-separated directories the agent can write to
# Leave empty to deny all writes
COPYPARTY_WRITABLE_DIRS=

# Optional: Max file size in bytes for reads (default: 10MB)
# COPYPARTY_MAX_FILE_SIZE=10485760
